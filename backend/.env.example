# INKGUARD Backend Environment Variables (Production & Development)

# Server Port (Render sets this dynamically, default is 5000 locally, 10000 on Render)
PORT=5000

# Node Environment
NODE_ENV=production

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/inkguard?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/inkguard?retryWrites=true&w=majority

# JWT Signing Secret (Generate a strong random string or Render will auto-generate)
JWT_SECRET=replace_with_a_super_strong_random_jwt_secret_key_in_production

# Cookie Encryption Secret
COOKIE_SECRET=replace_with_a_super_strong_random_cookie_secret_key_in_production

# Allowed Frontend URL(s) - e.g. your Vercel deployment URL (without trailing slash)
# Multiple origins can be comma-separated: https://inkguard.vercel.app,http://localhost:5173
FRONTEND_URL=https://your-frontend-app.vercel.app

# Optional AI Providers (System operates with deterministic governance if not provided)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
